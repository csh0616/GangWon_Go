# 프론트엔드 (Next.js) 환경변수 — 값은 절대 커밋하지 않음, 키 이름만 기록 (CLAUDE.md 3장)

# 백엔드 API 베이스 URL. 비어있으면 app/lib/api.ts가 목업 데이터로 동작한다.
NEXT_PUBLIC_API_BASE_URL=

# 카카오맵 JS SDK 앱 키 (PRD 3장 확정 기술스택). 비어있으면 지도 자리에 MapFallback이 뜬다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Supabase 프로젝트(백엔드와 공유) — 브라우저용 anon key만 여기 둔다. SERVICE_ROLE 키는
# RLS를 우회하므로 절대 프론트(Vercel) 환경변수에 넣지 않는다(서버/에이전트 전용).
# 비어있으면 로그인 관련 기능이 전부 "로그인 실패"로 동작한다(app/lib/supabase.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
