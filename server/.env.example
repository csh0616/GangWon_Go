# GANGWON GO 백엔드 환경변수 (PRD 9장 — 실제 값은 커밋 금지, 키 이름만 기록)

PORT=4000

# Supabase 프로젝트 대시보드 → Project Settings → API 에서 확인
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service role key는 RLS를 우회하는 트러스티드 서버 전용 키. 절대 프론트/클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (PRD 3.7절 — 벤더 확정)
ANTHROPIC_API_KEY=

# 카카오모빌리티 Directions API (PRD 3장 — 실제 동선/이동시간 표시)
KAKAO_MOBILITY_API_KEY=

# 기상청 단기예보 API 서비스키 (공공데이터포털)
KMA_SERVICE_KEY=

# CORS 허용 origin (콤마로 구분, PRD 6장/API_CONTRACT.md §0)
ALLOWED_ORIGINS=http://localhost:3000
